# Copy to .env.local (gitignored) for local /skills page support.
# Get a free Postgres URL from https://neon.tech — create a project, then copy
# the connection string from the Neon console (pooled or direct both work).
#
#   copy .env.local.example .env.local
#   # edit .env.local and paste your URL below
#
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Required for POST /api/skills in production. Use a long random string.
# In development, POST is allowed without this key when NODE_ENV is not production.
NEST_SKILLS_API_KEY=change-me-to-a-long-random-secret
