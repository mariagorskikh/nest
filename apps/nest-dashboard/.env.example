# Copy this file to .env.local. Never commit real values.

# Neon Postgres connection string — powers the SkillMD registry (/skills).
# Get one free at https://neon.tech (use the pooled connection string).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Required together only for Google sign-in and catalog voting. Generate a
# unique AUTH_SECRET for each deployment; do not use a shared example value.
AUTH_SECRET=""
APP_BASE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: higher GitHub API allowance for the historical PR gallery.
GITHUB_TOKEN=""

# Optional: authenticate POST /api/github/webhook cache invalidation.
GITHUB_WEBHOOK_SECRET=""
